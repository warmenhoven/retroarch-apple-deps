SDL_CFLAGS_YES = -DHAVE_SDL2
SDL_HEADERS_YES = $(RETROARCH_APPLE_DEPS)/sdl/include
SDL_HEADERS_MACOS_YES = $(RETROARCH_APPLE_DEPS)/sdl/macOS/include
SDL_HEADERS_IOS_YES = $(RETROARCH_APPLE_DEPS)/sdl/iOS/include
SDL_LIBRARY_MACOS_YES = $(RETROARCH_APPLE_DEPS)/sdl/macOS/lib/libSDL2.a
SDL_LIBRARY_IOS_YES = $(RETROARCH_APPLE_DEPS)/sdl/iOS/lib/libSDL2.a
COMMON_SDL_CFLAGS = $(SDL_CFLAGS_$(RETROARCH_APPLE_SDL)) -DHAVE_MICROPHONE -D_THREAD_SAFE

HEADER_SEARCH_PATHS[sdk=macosx*] = $(inherited) $(SDL_HEADERS_$(RETROARCH_APPLE_SDL)) $(SDL_HEADERS_MACOS_$(RETROARCH_APPLE_SDL))
OTHER_CFLAGS[sdk=macosx*] = $(inherited) $(COMMON_SDL_CFLAGS)
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) $(SDL_LIBRARY_MACOS_$(RETROARCH_APPLE_SDL)) -Wl,-framework,CoreVideo -Wl,-framework,Cocoa -Wl,-framework,IOKit -Wl,-framework,ForceFeedback -lobjc -Wl,-framework,Carbon -Wl,-framework,CoreAudio -Wl,-framework,AudioToolbox -Wl,-framework,AVFoundation -Wl,-framework,Foundation -Wl,-weak_framework,GameController -Wl,-weak_framework,Metal -Wl,-weak_framework,QuartzCore -Wl,-weak_framework,CoreHaptics -lm

HEADER_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SDL_HEADERS_$(RETROARCH_APPLE_SDL)) $(SDL_HEADERS_IOS_$(RETROARCH_APPLE_SDL))
OTHER_CFLAGS[sdk=iphoneos*] = $(inherited) $(COMMON_SDL_CFLAGS)
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) $(SDL_LIBRARY_IOS_$(RETROARCH_APPLE_SDL)) -Wl,-framework,CoreVideo -Wl,-framework,CoreAudio -Wl,-framework,AudioToolbox -Wl,-framework,AVFoundation -Wl,-framework,CoreBluetooth -Wl,-framework,CoreGraphics -Wl,-framework,CoreMotion -Wl,-framework,Foundation -Wl,-weak_framework,GameController -Wl,-framework,Metal -Wl,-framework,OpenGLES -Wl,-framework,QuartzCore -Wl,-framework,UIKit -Wl,-weak_framework,CoreHaptics -lpthread -lm
